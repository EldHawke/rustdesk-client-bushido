			</Component>
			<Component Guid="6582bd33-87f7-41e5-a9c7-4308f95e5c12" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/auth-gitlab.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="4e768467-5809-4e97-8f97-7b20fc5bc185" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/auth-google.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="6ee9cc6c-2f45-47fb-9bf9-39afad429092" Subdirectory="data\flutter_assets\assets">
