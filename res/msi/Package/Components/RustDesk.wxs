			</Component>
			<Component Guid="16bd644c-c57d-42b0-82dc-a2b8b7fcfef1" >
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/screen_retriever_plugin.dll" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="1c5e8aea-936e-4ef4-b017-4cb34f98dad1" >
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/texture_rgba_renderer_plugin.dll" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="643e14c3-56b3-4ab2-a93e-7713aa3fbebf" >
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/uni_links_desktop_plugin.dll" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="f14db703-0eed-4135-a81b-1416a2071018" >
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/url_launcher_windows_plugin.dll" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="f76be60c-76af-4ae7-a8b8-773d6d6fcf76" >
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/window_manager_plugin.dll" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="d8b86cec-6a40-42e7-8e94-e497ab497a84" >
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/window_size_plugin.dll" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="3fd848cb-4527-4bb4-8467-0029b72f6236" Subdirectory="data">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/app.so" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="021da062-9625-4cf7-b3ff-fb8dabc84f0e" Subdirectory="data">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/icudtl.dat" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="5ade9521-1ddb-4120-8692-5d1d5d4f5976" Subdirectory="data\flutter_assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/AssetManifest.bin" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="0adf710f-22a0-4149-8de2-bfd6e8613488" Subdirectory="data\flutter_assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/AssetManifest.json" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="429b2218-be9b-42b0-9862-5828dd44a718" Subdirectory="data\flutter_assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/FontManifest.json" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="4d92cb07-4845-4b63-81ce-8da68f1d2514" Subdirectory="data\flutter_assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/NOTICES.Z" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="f315f766-66ef-43df-9eff-1779c94c0956" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/actions.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="5225c978-9b85-455f-b1f2-1e15df627048" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/actions_mobile.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="d1aa3cb1-8077-432b-b60b-b9d7dd762c02" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/address_book.ttf" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="33055247-e131-4089-a559-5f71bc4e391b" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/android.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="d0d1dee6-f892-4e5b-a06b-a2c741489ff9" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/arrow.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="c11c38d3-47cc-400a-9bcf-37894e1d8725" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/auth-apple.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="34e6f500-8a01-42aa-900f-9e3ed5cf1d97" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/auth-auth0.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="a79f490e-a56f-4618-8f13-bfcdc7a52af9" Subdirectory="data\flutter_assets\assets">
