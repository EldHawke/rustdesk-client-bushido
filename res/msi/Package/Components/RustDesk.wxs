			</Component>
			<Component Guid="12713f90-5040-4fbd-8428-632308828b38" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/auth-gitlab.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="0ea1d052-10f6-4e20-9720-85cff17def0a" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/auth-google.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="d5eb078f-f8a1-4bff-ae77-435a6f48d9e3" Subdirectory="data\flutter_assets\assets">
