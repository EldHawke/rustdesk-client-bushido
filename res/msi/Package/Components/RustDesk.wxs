			</Component>
			<Component Guid="1be7cce5-d4ce-49f8-b96e-7e91785ad3f0" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/call_end.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="84aa6fe6-351d-4993-a21e-11677026f28b" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/call_wait.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="f67a0aee-b7dc-4ff6-abf2-87d4cb0a7ec9" Subdirectory="data\flutter_assets\assets">
