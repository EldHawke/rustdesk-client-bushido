			</Component>
			<Component Guid="ed8b11db-f555-4c68-8afe-57767be51b3b" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/call_end.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="819c23e0-5fa0-4349-bdd1-29f7c376475f" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/call_wait.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="69a2f00b-2d8a-4c91-b9bc-3cd9aac366f7" Subdirectory="data\flutter_assets\assets">
