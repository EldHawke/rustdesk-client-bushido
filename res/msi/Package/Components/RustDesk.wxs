			</Component>
			<Component Guid="0e4db15c-0725-46ea-ae5e-8c3bf02dba98" Subdirectory="data\flutter_assets\assets">
				<File Source="D:/React_Native_Development/rustdesk-client-bushido/rustdesk/data/flutter_assets/assets/auth-facebook.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="1e5abd51-e0d1-412c-99e2-b36793cb7571" Subdirectory="data\flutter_assets\assets">
